---
import Rambu from "./Rambu.astro";
import type { Day } from "../types";

interface Props {
  data: Day;
}

const { data } = Astro.props;
---

<section id={data.id} class="day-section relative py-24 sm:py-28 bg-[var(--color-kertas-2)] scroll-mt-4">
  <div class="mx-auto max-w-[1400px] px-5 lg:pl-[108px] lg:pr-12">
    <div class="grid lg:grid-cols-[280px_1fr] gap-12">
      <div class="sticky-rambu lg:sticky lg:top-28 lg:self-start">
        <Rambu dayNumber={data.day} date={data.date} />
        <p class="mt-4 font-['DM_Mono'] text-[0.65rem] uppercase tracking-[0.2em] text-[var(--color-tinta-soft)]">
          {data.location}
        </p>
      </div>

      <div class="min-w-0">
        <p class="font-['DM_Mono'] text-xs uppercase tracking-[0.2em] text-[var(--color-tinta-soft)]">
          {data.category}
        </p>
        <h3 class="mt-2 font-['Archivo'] font-black uppercase tracking-tight leading-[0.95] text-3xl sm:text-5xl max-w-2xl">
          {data.title}
        </h3>

        <!-- Kolase longgar -->
        <div class="relative mt-12">
          <!-- Stiker pita marka -->
          <span class="absolute -top-6 right-0 sm:right-10 z-20 font-['DM_Mono'] text-[0.65rem] uppercase tracking-[0.15em] bg-[var(--color-marka)] border-2 border-[var(--color-tinta)] px-3 py-1.5 -rotate-3 shadow-[3px_3px_0_var(--color-tinta)]">
            hari paling santai
          </span>

            <div class="grid sm:grid-cols-2 gap-8 items-start max-w-4xl">
              {data.photos.map((p, i) => (
                <figure class={`relative ${i === 0 ? "rotate-[-1.5deg]" : "rotate-[1.5deg]"}`}>
                  <div class="absolute -top-3 left-1/2 -translate-x-1/2 w-20 h-6 bg-[var(--color-marka)]/70 -rotate-3 z-10"></div>
                  <img
                    src={p.src}
                    alt={p.alt}
                    loading="lazy"
                    class="reveal-tirai w-full aspect-[16/10] object-cover border-4 border-[var(--color-kertas)] shadow-[6px_6px_0_var(--color-tinta)]"
                  />
                  <figcaption class="mt-3 font-['DM_Mono'] text-[0.7rem] uppercase tracking-[0.15em] text-[var(--color-tinta-soft)]">
                    {p.caption}
                  </figcaption>
                </figure>
              ))}
            </div>
        </div>

        <p class="mt-12 max-w-2xl text-[1.05rem] leading-[1.65]">{data.description}</p>

        <blockquote class="mt-8 max-w-2xl border-l-4 border-[var(--color-marka)] pl-5">
          <p class="font-['Caveat'] text-2xl sm:text-3xl leading-snug -rotate-1">“{data.quote}”</p>
        </blockquote>


      </div>
    </div>
  </div>
</section>
