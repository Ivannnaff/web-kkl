---
interface Chapter {
  time: string;
  label: string;
  jump: number;
}

interface Vlog {
  eyebrow: string;
  title: string;
  subtitle: string;
  poster: string;
  youtubeId: string;
  file: string;
  duration: string;
  chapters: Chapter[];
}

interface Props {
  vlog: Vlog;
}

const { vlog } = Astro.props;
---

<section id="vlog" class="py-32 sm:py-40 bg-[var(--color-aspal)] text-[var(--color-kertas)] scroll-mt-4 border-y-2 border-[#2A2825]">
  <div class="mx-auto max-w-[1000px] px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 font-['Doto'] text-sm text-[var(--color-led)] led-glow mb-3">
        <span class="inline-block w-2.5 h-2.5 rounded-full bg-[var(--color-led)]"></span>
        {vlog.eyebrow}
      </div>
      <h2 class="font-['Archivo'] font-black uppercase tracking-tight text-4xl sm:text-6xl leading-[0.92]">
        {vlog.title}
      </h2>
      <p class="mt-4 text-lg text-[var(--color-kertas)]/70 leading-relaxed">{vlog.subtitle}</p>
    </div>

    <!-- Monitor bus (Clean full width) -->
    <div class="rounded-t-[32px] border-[14px] border-[#111] bg-[#111] overflow-hidden relative shadow-[8px_8px_0_var(--color-marka)]">
      <div class="relative aspect-video bg-[#0A0A09]">
        <img
          id="vlog-poster"
          src={vlog.poster}
          alt="Poster video vlog perjalanan KKL Bali Tim 9"
          loading="lazy"
          class="absolute inset-0 w-full h-full object-cover"
        />
        <div
          id="vlog-mount"
          class="absolute inset-0"
          data-youtube={vlog.youtubeId}
          data-file={vlog.file}
        ></div>
        <button
          type="button"
          id="vlog-play"
          class="absolute inset-0 m-auto h-20 w-20 sm:h-24 sm:w-24 rounded-full bg-[var(--color-marka)] border-[3px] border-[var(--color-tinta)] text-[var(--color-tinta)] font-['Archivo'] font-black text-lg sm:text-xl shadow-[4px_4px_0_rgba(0,0,0,.6)] hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[2px_2px_0_rgba(0,0,0,.6)] transition-all"
          aria-label="Putar video vlog"
        >
          ▶
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const playBtn = document.getElementById("vlog-play");
  const poster = document.getElementById("vlog-poster");
  const mount = document.getElementById("vlog-mount");
  const youtubeId = mount?.getAttribute("data-youtube") || "";
  const file = mount?.getAttribute("data-file") || "";

  let player: { seek: (t: number) => void } | null = null;

  function buildPlayer(startAt = 0) {
    if (!mount) return null;
    if (youtubeId) {
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&rel=0&start=${startAt}`;
      iframe.title = "Vlog perjalanan KKL Bali Tim 9";
      iframe.allow = "accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture";
      iframe.allowFullscreen = true;
      iframe.className = "absolute inset-0 w-full h-full border-0";
      mount.appendChild(iframe);
      return {
        seek: (t: number) => {
          iframe.src = `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&rel=0&start=${t}`;
        },
      };
    }
    if (file) {
      const video = document.createElement("video");
      video.src = file;
      video.controls = true;
      video.autoplay = true;
      video.playsInline = true;
      video.preload = "none";
      video.className = "absolute inset-0 w-full h-full object-cover";
      mount.appendChild(video);
      return {
        seek: (t: number) => {
          video.currentTime = t;
          video.play().catch(() => {});
        },
      };
    }
    return null;
  }

  function startPlayer(startAt = 0) {
    if (!player) player = buildPlayer(startAt);
    poster?.classList.add("hidden");
    playBtn?.classList.add("hidden");
  }

  playBtn?.addEventListener("click", () => startPlayer(0));
</script>
