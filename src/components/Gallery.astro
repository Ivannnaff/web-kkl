---
import WindowFrame from "./WindowFrame.astro";

interface GalleryPhoto {
  src: string;
  alt: string;
  caption: string;
  category: string;
}

interface Props {
  photos: GalleryPhoto[];
}

const { photos } = Astro.props;

const categories = [
  { id: "semua", label: "Semua" },
  { id: "Budaya", label: "Budaya" },
  { id: "Edukasi", label: "Edukasi" },
  { id: "Lainnya", label: "Lainnya" },
];

const counts = categories
  .map((c) => ({
    ...c,
    total: c.id === "semua" ? photos.length : photos.filter((p) => p.category === c.id).length,
  }))
  .filter((c) => c.total > 0);
---

<section id="galeri" class="py-32 sm:py-40 bg-[var(--color-kertas-2)] border-y-2 border-[var(--color-garis)] scroll-mt-4">
  <div class="mx-auto max-w-[1400px] px-8 lg:px-16">
    <div class="flex flex-wrap items-end justify-between gap-6 border-b-2 border-[var(--color-tinta)] pb-5">
      <div>
        <p class="font-['DM_Mono'] text-xs uppercase tracking-[0.2em] text-[var(--color-tinta-soft)] mb-2">Bagian 04</p>
        <h2 class="font-['Archivo'] font-black uppercase tracking-tight text-4xl sm:text-6xl leading-[0.9]">Dari Balik<br />Jendela</h2>
      </div>
      <p class="font-['Caveat'] text-2xl -rotate-2 max-w-xs text-[var(--color-tinta-soft)]">yang terlewat lewat kaca, kami simpan di sini</p>
    </div>

    <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter foto per kategori">
      {counts.map((c, i) => (
        <button
          type="button"
          data-filter={c.id}
          class={`filter-chip font-['DM_Mono'] text-xs uppercase tracking-[0.12em] px-4 py-2 border-2 border-[var(--color-tinta)] transition-colors ${i === 0 ? 'bg-[var(--color-tinta)] text-[var(--color-kertas)]' : 'bg-transparent text-[var(--color-tinta)] hover:bg-[var(--color-marka)]'}`}
        >
          {c.label} <span class="opacity-60">({c.total})</span>
        </button>
      ))}
    </div>

    <!-- Desktop & Mobile: Clean Horizontal Slide / Carousel Gallery -->
    <div class="mt-10 flex gap-5 overflow-x-auto snap-x snap-mandatory pb-6 pt-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden scroll-smooth">
      {photos.map((p, i) => (
        <div
          class="gallery-item shrink-0 w-[280px] sm:w-[340px] snap-start group relative overflow-hidden rounded-[20px] border-2 border-[var(--color-tinta)] bg-[#111] cursor-pointer aspect-[4/3]"
          data-category={p.category}
        >
          <img
            src={p.src}
            alt={p.alt}
            loading="lazy"
            class="gallery-trigger absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
            data-caption={p.caption || p.alt}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
            <div class="absolute bottom-0 inset-x-0 p-5 text-[var(--color-kertas)] flex flex-col justify-end translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
              <span class="font-['DM_Mono'] text-[0.6rem] uppercase tracking-[0.2em] text-[var(--color-marka)] mb-1">
                {p.category}
              </span>
              <p class="font-['Archivo'] font-bold text-sm leading-tight drop-shadow-md">
                {p.caption || p.alt}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <p class="mt-4 text-center font-['DM_Mono'] text-[0.65rem] uppercase tracking-[0.2em] text-[var(--color-tinta-soft)]">
      ← geser untuk melihat galeri foto lainnya →
    </p>

    <p class="mt-4 text-center font-['DM_Mono'] text-[0.65rem] uppercase tracking-[0.2em] text-[var(--color-tinta-soft)]">
      arahkan kursor atau sentuh foto untuk melihat lebih jelas
    </p>
  </div>
</section>

<dialog
  id="lightbox"
  aria-label="Pratinjau foto galeri"
  class="m-auto p-0 border-0 bg-transparent max-w-[96vw] max-h-[96vh] overflow-visible backdrop:bg-black/90"
>
  <div class="relative flex items-center justify-center">
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="block max-h-[82vh] max-w-[86vw] object-contain border-2 border-[var(--color-kertas)]/20 bg-[var(--color-aspal)] shadow-[0_20px_60px_rgba(0,0,0,.7)]"
    />
    <button
      type="button"
      id="lightbox-close"
      aria-label="Tutup galeri"
      class="absolute -top-4 -right-4 w-12 h-12 bg-[var(--color-marka)] text-[var(--color-tinta)] border-2 border-[var(--color-tinta)] font-['Archivo'] font-black text-xl leading-none shadow-[3px_3px_0_var(--color-tinta)]"
    >×</button>
    <button
      type="button"
      id="lightbox-prev"
      aria-label="Foto sebelumnya"
      class="absolute left-3 top-1/2 -translate-y-1/2 w-11 h-11 bg-[var(--color-kertas)]/90 backdrop-blur-sm text-[var(--color-tinta)] border-2 border-[var(--color-tinta)] font-['Archivo'] font-black text-xl leading-none"
    >‹</button>
    <button
      type="button"
      id="lightbox-next"
      aria-label="Foto berikutnya"
      class="absolute right-3 top-1/2 -translate-y-1/2 w-11 h-11 bg-[var(--color-kertas)]/90 backdrop-blur-sm text-[var(--color-tinta)] border-2 border-[var(--color-tinta)] font-['Archivo'] font-black text-xl leading-none"
    >›</button>
  </div>
</dialog>

<style>
  /* Tailwind preflight menghapus margin:auto bawaan <dialog>, jadi kita paksa dialog benar-benar di tengah. */
  dialog#lightbox[open] {
    position: fixed;
    inset: 0;
    width: fit-content;
    height: fit-content;
    max-width: 96vw;
    max-height: 96vh;
    margin: auto;
    display: grid;
    place-items: center;
  }

  dialog#lightbox::backdrop {
    background: rgba(0, 0, 0, 0.9);
  }
</style>
