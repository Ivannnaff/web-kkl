---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`bg-[var(--color-kertas-2)] border-2 border-[var(--color-tinta)] p-5 relative shadow-[4px_4px_0_var(--color-tinta)] ${className}`}>
  <div class="absolute -left-3 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full bg-[var(--color-kertas)] border-2 border-[var(--color-tinta)]"></div>
  <div class="absolute -right-3 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full bg-[var(--color-kertas)] border-2 border-[var(--color-tinta)]"></div>
  <slot />
</div>
