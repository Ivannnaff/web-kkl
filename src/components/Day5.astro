---
import Rambu from "./Rambu.astro";
import type { Day } from "../types";

interface Props {
  data: Day;
}

const { data } = Astro.props;
---

<section id={data.id} class="relative py-24 sm:py-28 bg-[var(--color-aspal)] text-[var(--color-kertas)] scroll-mt-4">
  <div class="mx-auto max-w-[1400px] px-5 lg:pl-[108px] lg:pr-12">
    <div class="grid lg:grid-cols-[280px_1fr] gap-12">
      <div class="sticky-rambu lg:sticky lg:top-28 lg:self-start">
        <Rambu dayNumber={data.day} date={data.date} isDark />
        <p class="mt-4 font-['DM_Mono'] text-[0.65rem] uppercase tracking-[0.2em] text-[var(--color-kertas)]/50">
          {data.location}
        </p>
      </div>

      <div class="min-w-0">
        <p class="font-['DM_Mono'] text-xs uppercase tracking-[0.2em] text-[var(--color-led)]">
          {data.category}
        </p>
        <h3 class="mt-3 font-['Doto'] text-[clamp(2rem,6vw,3.6rem)] leading-[1.05] text-[var(--color-led)] led-glow">
          {data.title.toUpperCase()}
        </h3>

        <!-- Hitung mundur: SEMARANG 0 KM -->
        <div class="mt-10 border-2 border-[var(--color-kertas)]/25 p-5 sm:p-6 inline-block">
          <p class="font-['DM_Mono'] text-[0.65rem] uppercase tracking-[0.25em] text-[var(--color-kertas)]/50">
            tujuan akhir
          </p>
          <p class="mt-2 font-['Doto'] text-3xl sm:text-4xl text-[var(--color-led)] led-glow">
            SEMARANG <span class="led-odometer" data-from="999" data-to="0" data-pad="3">000</span> KM
          </p>
          <div class="mt-4 h-2 w-full bg-[var(--color-kertas)]/15">
            <div class="h-full w-full bg-[var(--color-marka)]"></div>
          </div>
          <p class="mt-3 font-['DM_Mono'] text-[0.65rem] uppercase tracking-[0.2em] text-[var(--color-kertas)]/50">
            <span class="led-odometer" data-from="9" data-to="0" data-pad="2">09</span> jam lagi · roda hampir berhenti
          </p>
        </div>

        <p class="mt-10 max-w-2xl text-[1.05rem] leading-[1.65] text-[var(--color-kertas)]/85">
          {data.description}
        </p>

        <!-- Foto kecil -->
        <div class="mt-12 grid grid-cols-3 gap-4 max-w-2xl">
          {data.photos.map((p) => (
            <figure>
              <img
                src={p.src}
                alt={p.alt}
                loading="lazy"
                class="reveal-tirai w-full aspect-square object-cover border border-[var(--color-kertas)]/25 opacity-90"
              />
              <figcaption class="mt-2 font-['DM_Mono'] text-[0.6rem] uppercase tracking-[0.12em] text-[var(--color-kertas)]/45">
                {p.caption}
              </figcaption>
            </figure>
          ))}
        </div>

        <blockquote class="mt-10 max-w-2xl border-l-4 border-[var(--color-marka)] pl-5">
          <p class="font-['Caveat'] text-2xl sm:text-3xl leading-snug text-[var(--color-kertas)] -rotate-1">“{data.quote}”</p>
        </blockquote>


      </div>
    </div>
  </div>
</section>
